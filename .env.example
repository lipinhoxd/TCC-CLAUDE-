# Copie para .env.local e ajuste. Nunca versione valores reais.

# API (server/)
HOST=127.0.0.1
PORT=3001

# Front-end (src/). Apenas variaveis iniciadas por VITE_ chegam ao navegador.
VITE_APP_NAME=BPM Trip

# Banco de dados (SQLite via node:sqlite). Arquivo local; use ":memory:" para banco temporario.
DATABASE_PATH=data/excursoes.sqlite

# Autenticacao (server/auth). Valores padrao entre parenteses.
# SESSION_TTL_HOURS=8
# RECOVERY_TOKEN_TTL_MINUTES=30
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MINUTES=15
# COOKIE_SECURE=false            # padrao: true apenas com NODE_ENV=production
# RECOVERY_OUTBOX_PATH=data/outbox/recuperacao.jsonl   # entrega local do token; desligada em producao

# Criacao do administrador (npm run admin:create). Preencha so no momento do uso e nao versione.
# ADMIN_NOME=
# ADMIN_CPF=
# ADMIN_EMAIL=
# ADMIN_NASCIMENTO=AAAA-MM-DD
# ADMIN_TELEFONE=
# ADMIN_SENHA=

# Reservas (server/reservas). Valor padrao entre parenteses.
# RETENCAO_MINUTOS=15            # duracao da retencao temporaria de vaga no checkout (1 a 1440)

# Processos automaticos (server/processos). Valor padrao entre parenteses. `npm run rotina` executa uma vez.
# ROTINA_INTERVALO_SEGUNDOS=60   # intervalo da rotina dentro da API (0 desliga; ate 86400)

# Comunicacao (server/comunicacao). Fora de producao o e-mail e simulado em arquivo local; em producao nada e enviado.
# EMAIL_SIMULADO=true            # false deixa os e-mails pendentes
# COMUNICACAO_OUTBOX_PATH=data/outbox/comunicacao.jsonl

# Pagamento (server/pagamentos). Fora de producao usa o provedor simulado; em producao nao ha provedor e o pagamento responde 503.
# PAGAMENTO_SIMULADO=true        # false desliga o provedor simulado fora de producao
